# NVD API Key (optional — increases rate limit from 5 req/30s to 50 req/30s)
# Request a free key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Azure OpenAI (optional — enables LLM-powered remediation playbooks)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01

# LLM tuning
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# CISA KEV cache
KEV_CACHE_TTL_HOURS=24
KEV_CACHE_PATH=.cache/kev_catalog.json

# Scanner settings
OUTPUT_DIR=output
LOG_LEVEL=INFO
MAX_CONCURRENT_QUERIES=5
NVD_RATE_LIMIT_DELAY=0.6

# Webhook alerting (optional — sends alerts on critical findings)
# Supports: slack, teams, generic
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TYPE=generic

# Internal API access; required before exposing the service beyond localhost.
SCANNER_API_KEY=
# Comma-separated browser origins; empty disables cross-origin browser access.
SCANNER_CORS_ORIGINS=
